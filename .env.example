# Copy this file to .env and fill in your Telegram token.
# Then run: docker compose up -d --build
# Check: docker ps
# Pull model: docker compose exec ollama ollama pull deepseek-llm:7b
# List models: docker compose exec ollama ollama ls
#
# MongoDB password (used in MONGO_URI below):  llmtodo_secret_2025
# Connect to Mongo: mongodb://bot:llmtodo_secret_2025@localhost:27017 (when port exposed) or from host: docker compose exec mongo mongosh -u bot -p llmtodo_secret_2025

# Telegram (required)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# MongoDB (user/password set in docker-compose)
MONGO_URI=mongodb://bot:llmtodo_secret_2025@mongo:27017
MONGO_DB_NAME=llm_todo_bot

# Ollama — use deepseek-llm:7b (pull with: docker compose exec ollama ollama pull deepseek-llm:7b)
LLM_MODEL=ollama/deepseek-llm:7b
LLM_BASE_URL=http://ollama:11434

# Optional
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
MAX_TASKS_PER_USER=200
RATE_LIMIT_PER_MINUTE=10
