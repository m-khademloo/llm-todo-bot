# Copy to .env and set your values. Then: docker compose up -d --build
# LLM is configured via LLM_MODEL + optional LLM_BASE_URL / API keys (LiteLLM).
# Mongo and Ollama/LLM run on host or elsewhere; only the bot runs in Docker.

# --- Required ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB_NAME=llm_todo_bot

# --- LLM (pick one; LiteLLM supports 100+ providers) ---

# Ollama on host (https://localhost:11434 or http)
LLM_MODEL=ollama/deepseek-llm:7b
LLM_BASE_URL=http://host.docker.internal:11434

# OpenAI
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# DeepSeek
# LLM_MODEL=deepseek/deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# Anthropic Claude
# LLM_MODEL=anthropic/claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
MAX_TASKS_PER_USER=200
RATE_LIMIT_PER_MINUTE=10
